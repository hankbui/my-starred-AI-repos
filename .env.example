# GitHub personal access token with access to this repository.
GITHUB_TOKEN=
GITHUB_USERNAME=hankbui

# ── Idea Scraper ───────────────────────────────────────────────────────
# Product Hunt: free developer token from https://api.producthunt.com/v2/docs
PRODUCTHUNT_TOKEN=

# Reddit: free script app from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-scraper/0.1

# YouTube: API key from Google Cloud Console → YouTube Data API v3
YOUTUBE_API_KEY=

# ── Telegram Notification ──────────────────────────────────────────────
# Bot token from @BotFather. Channel @username or numeric chat id.
# Add both as GitHub Secrets (Settings → Secrets → Actions) under the same names.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# Optional: route each digest section into its own forum topic.
# Get the IDs with `python scripts/telegram_topics.py` after enabling
# Topics on the channel. JSON mapping section -> message_thread_id:
TG_THREADS=
