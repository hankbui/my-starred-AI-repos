# GitHub personal access token with access to this repository.
GITHUB_TOKEN=your_github_token_here
SITE_DEPLOY_TOKEN=your_deploy_token_here
# Product Hunt
PRODUCTHUNT_TOKEN=your_producthunt_token_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM local (chạy trên Mac Studio, MacBook gọi qua symlink)
# LM Studio: cổng OpenAI-compatible mặc định 1234; Ollama: 11434
LLM_BASE_URL=http://mac-studio-local:1234
LLM_MODEL=qwen2.5-7b-instruct-1m
# Model sẽ tự fallback sang model đang load trong LM Studio nếu LLM_MODEL không có
# LLM_API_KEY=your_llm_api_key_if_needed
